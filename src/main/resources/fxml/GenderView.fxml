<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="620.0" prefWidth="980.0" styleClass="onb-root" stylesheets="@../css/onboarding.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.GenderController">
   <children>
      <VBox alignment="CENTER" maxWidth="420.0" spacing="18.0" styleClass="onb-card">
         <children>
            <Label styleClass="onb-title" text="What's Your Gender?" />
            <Label styleClass="onb-subtitle" text="This helps us customize calculations and recommendations." wrapText="true" />
            <HBox alignment="CENTER" spacing="16.0">
               <children>
                  <Button fx:id="maleButton" mnemonicParsing="false" onAction="#onSelectMale" prefHeight="110.0" prefWidth="150.0" styleClass="choice-card" text="♂&#10;Male" />
                  <Button fx:id="femaleButton" mnemonicParsing="false" onAction="#onSelectFemale" prefHeight="110.0" prefWidth="150.0" styleClass="choice-card" text="♀&#10;Female" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="12.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onBack" styleClass="btn-back" text="← Back" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onContinue" styleClass="btn-continue" text="Continue →" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="22.0" left="26.0" right="26.0" top="24.0" />
         </padding>
      </VBox>
   </children>
</StackPane>

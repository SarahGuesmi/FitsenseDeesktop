<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16.0" styleClass="user-workouts-root" stylesheets="@../css/user_workouts.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.UserWorkoutsController">

    <!-- Exercises Library button -->
    <HBox style="-fx-padding:0 0 4 0;" spacing="10.0">
        <Button mnemonicParsing="false" onAction="#onOpenExerciseLibrary"
                style="-fx-background-color:linear-gradient(to right,#3B82F6,#6366F1);-fx-text-fill:white;-fx-font-weight:800;-fx-font-size:13px;-fx-background-radius:12;-fx-padding:10 20;-fx-cursor:hand;"
                text="⚡  Exercises Library" />
        <Button mnemonicParsing="false" onAction="#onOpenActivityLog"
                style="-fx-background-color:#1F2937;-fx-border-color:#374151;-fx-border-radius:12;-fx-background-radius:12;-fx-text-fill:#9CA3AF;-fx-font-weight:700;-fx-font-size:13px;-fx-padding:10 20;-fx-cursor:hand;"
                text="🕐  Activity Log" />
    </HBox>

    <!-- Objective pills -->
    <FlowPane fx:id="objectivePillsPane" hgap="8.0" vgap="8.0" />

    <!-- Filters -->
    <HBox spacing="12.0" alignment="CENTER_LEFT">
        <ComboBox fx:id="levelFilter" styleClass="filter-combo"
                  prefWidth="160.0" onAction="#onFilter" />
        <ComboBox fx:id="durationFilter" styleClass="filter-combo"
                  prefWidth="160.0" onAction="#onFilter" />
    </HBox>

    <!-- Workouts grid (2 columns) -->
    <ScrollPane fitToWidth="true" styleClass="workouts-scroll" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox fx:id="workoutsContainer" spacing="0.0" />
    </ScrollPane>

    <padding><Insets bottom="18.0" left="18.0" right="18.0" top="18.0" /></padding>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="700.0" prefWidth="1100.0" styleClass="dash-root" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DashboardController">
   <children>
      <BorderPane>
         <left>
            <VBox prefWidth="250.0" spacing="14.0" styleClass="dash-sidebar">
               <children>
                  <Label styleClass="dash-brand" text="FITSENSE" />
                  <Label styleClass="dash-side-sub" text="YOUR SPACE" />
                  <Button fx:id="dashHomeBtn" mnemonicParsing="false" onAction="#onShowDashboard" styleClass="dash-side-link" text="◈  Dashboard" />
                  <Button fx:id="dashProfileBtn" mnemonicParsing="false" onAction="#onShowProfile" styleClass="dash-side-link" text="☺  Profile" />
                  <Button fx:id="dashWorkoutsBtn" mnemonicParsing="false" onAction="#onShowWorkouts" styleClass="dash-side-link" text="▣  My Workouts" />
                  <Button mnemonicParsing="false" styleClass="dash-side-link" text="◉  Mental Health" />
                  <Button mnemonicParsing="false" styleClass="dash-side-link" text="◇  Nutrition" />
                  <Button mnemonicParsing="false" styleClass="dash-side-link" text="💬  Chatroom" />
                  <Button mnemonicParsing="false" onAction="#onTestFeedback" styleClass="dash-side-link" text="🧪  Test Feedback" />
                  <Region VBox.vgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#onLogout" styleClass="dash-side-link" text="⏻  Sign Out" />
               </children>
               <padding>
                  <Insets bottom="22.0" left="18.0" right="18.0" top="22.0" />
               </padding>
            </VBox>
         </left>
         <center>
            <VBox styleClass="dash-main-area" BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" styleClass="dash-navbar" VBox.vgrow="NEVER">
                     <children>
                        <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                           <children>
                              <Label fx:id="navbarPageTitle" styleClass="dash-navbar-title" text="Dashboard" />
                              <Label fx:id="navbarPageSubtitle" styleClass="dash-navbar-subtitle" text="Your fitness overview" />
                           </children>
                        </VBox>
                        <Button fx:id="navbarBellBtn" focusTraversable="false" mnemonicParsing="false" styleClass="dash-navbar-bell" text="" />
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="dash-navbar-profile">
                           <children>
                              <VBox alignment="CENTER_LEFT" spacing="2.0">
                                 <children>
                                    <Label fx:id="navbarUserName" styleClass="dash-navbar-user-name" text="—" />
                                    <Label fx:id="navbarUserRole" styleClass="dash-navbar-user-role" text="User" />
                                 </children>
                              </VBox>
                              <Label fx:id="navbarAvatar" alignment="CENTER" styleClass="dash-navbar-avatar" text="?" />
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
                     </padding>
                  </HBox>
                  <StackPane styleClass="dash-center-stack" VBox.vgrow="ALWAYS">
                     <children>
                        <VBox fx:id="dashHomePane" spacing="18.0" styleClass="dash-content">
                           <children>
                              <VBox spacing="10.0" styleClass="hero-card">
                                 <children>
                                    <Label fx:id="welcomeLabel" styleClass="hero-title" text="Welcome back!" />
                                    <Label styleClass="hero-subtitle" text="Ready to crush your goals today? Your plan is waiting for you." wrapText="true" />
                                    <HBox spacing="10.0">
                                       <children>
                                          <Button mnemonicParsing="false" styleClass="hero-primary-btn" text="Start Training" />
                                          <Button mnemonicParsing="false" styleClass="hero-secondary-btn" text="Mental Check" />
                                       </children>
                                    </HBox>
                                 </children>
                                 <padding>
                                    <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
                                 </padding>
                              </VBox>
                           </children>
                           <padding>
                              <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
                           </padding>
                        </VBox>
                        <VBox fx:id="dashProfilePane" alignment="TOP_CENTER" managed="false" styleClass="dash-content" visible="false" StackPane.alignment="TOP_CENTER">
                           <children>
                              <fx:include fx:id="dashProfile" source="ProfileFragment.fxml" />
                           </children>
                           <padding>
                              <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
                           </padding>
                        </VBox>
                        <VBox fx:id="dashWorkoutsPane" managed="false" visible="false"
                              styleClass="dash-content" VBox.vgrow="ALWAYS">
                           <children>
                              <StackPane fx:id="workoutsStack" VBox.vgrow="ALWAYS">
                                 <children>
                                    <VBox fx:id="workoutsFragmentPane" VBox.vgrow="ALWAYS">
                                       <fx:include fx:id="dashWorkouts" source="UserWorkoutsFragment.fxml" VBox.vgrow="ALWAYS" />
                                    </VBox>
                                    <VBox fx:id="libraryPane" managed="false" visible="false" VBox.vgrow="ALWAYS" />
                                 </children>
                              </StackPane>
                           </children>
                        </VBox>

                        <!-- Activity Log pane -->
                        <VBox fx:id="dashActivityPane" managed="false" visible="false"
                              styleClass="dash-content" VBox.vgrow="ALWAYS">
                           <children>
                              <fx:include fx:id="dashActivity" source="ActivityLogView.fxml" VBox.vgrow="ALWAYS" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</StackPane>

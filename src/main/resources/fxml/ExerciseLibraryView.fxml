<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox style="-fx-background-color:#070b16;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.ExerciseLibraryController">

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color:#070b16;-fx-background:#070b16;-fx-border-color:transparent;">
        <VBox spacing="20.0">
            <padding><Insets top="24.0" bottom="40.0" left="28.0" right="28.0"/></padding>

            <!-- Back -->
            <Button mnemonicParsing="false" onAction="#onBack"
                    style="-fx-background-color:transparent;-fx-text-fill:#6B7280;-fx-font-size:13px;-fx-font-weight:600;-fx-cursor:hand;-fx-padding:4 0;"
                    text="← Back to My Workouts" />

            <!-- Header -->
            <VBox spacing="4.0">
                <Label style="-fx-text-fill:white;-fx-font-size:26px;-fx-font-weight:900;" text="Exercise Library" />
                <Label style="-fx-text-fill:#6B7280;-fx-font-size:13px;" text="Browse and discover exercises tailored to your goals" />
            </VBox>

            <!-- Search + filters card -->
            <VBox style="-fx-background-color:#111827;-fx-border-color:#1F2937;-fx-border-radius:16;-fx-background-radius:16;-fx-padding:20;" spacing="14.0">
                <!-- Search row -->
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="Search exercise by name…"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:12;-fx-background-radius:12;-fx-text-fill:white;-fx-prompt-text-fill:#6B7280;-fx-padding:10 16;-fx-font-size:13px;"
                               onAction="#onSearch" />
                    <Button mnemonicParsing="false" onAction="#onSearch"
                            style="-fx-background-color:#3B82F6;-fx-text-fill:white;-fx-font-weight:800;-fx-font-size:13px;-fx-background-radius:12;-fx-padding:10 20;-fx-cursor:hand;"
                            text="🔍  Search" />
                    <Button fx:id="resetBtn" mnemonicParsing="false" onAction="#onReset"
                            managed="false" visible="false"
                            style="-fx-background-color:#1F2937;-fx-border-color:#374151;-fx-border-radius:12;-fx-background-radius:12;-fx-text-fill:#9CA3AF;-fx-font-size:13px;-fx-padding:10 16;-fx-cursor:hand;"
                            text="✕ Reset" />
                </HBox>

                <!-- Body Part filter -->
                <VBox spacing="8.0">
                    <HBox spacing="6.0" alignment="CENTER_LEFT">
                        <Label style="-fx-text-fill:#3B82F6;-fx-font-size:11px;" text="⚡" />
                        <Label style="-fx-text-fill:#6B7280;-fx-font-size:11px;-fx-font-weight:800;" text="BODY PART" />
                    </HBox>
                    <FlowPane fx:id="bodyPartPane" hgap="8.0" vgap="6.0" />
                </VBox>

                <!-- Target Muscle filter -->
                <VBox spacing="8.0">
                    <HBox spacing="6.0" alignment="CENTER_LEFT">
                        <Label style="-fx-text-fill:#10B981;-fx-font-size:11px;" text="🎯" />
                        <Label style="-fx-text-fill:#6B7280;-fx-font-size:11px;-fx-font-weight:800;" text="TARGET MUSCLE" />
                    </HBox>
                    <FlowPane fx:id="targetPane" hgap="8.0" vgap="6.0" />
                </VBox>

                <!-- Equipment filter -->
                <VBox spacing="8.0">
                    <HBox spacing="6.0" alignment="CENTER_LEFT">
                        <Label style="-fx-text-fill:#8B5CF6;-fx-font-size:11px;" text="🏋" />
                        <Label style="-fx-text-fill:#6B7280;-fx-font-size:11px;-fx-font-weight:800;" text="EQUIPMENT" />
                    </HBox>
                    <ComboBox fx:id="equipmentCombo" promptText="All equipment"
                              style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:12;-fx-background-radius:12;-fx-text-fill:white;-fx-font-size:13px;"
                              prefWidth="220.0" onAction="#onEquipmentFilter" />
                </VBox>

                <!-- Active filters + count -->
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <FlowPane fx:id="activeFiltersPane" hgap="6.0" vgap="4.0" HBox.hgrow="ALWAYS" />
                    <Label fx:id="countLabel"
                           style="-fx-text-fill:#6B7280;-fx-font-size:12px;-fx-font-weight:700;" text="" />
                </HBox>
            </VBox>

            <!-- Loading indicator -->
            <HBox fx:id="loadingBox" alignment="CENTER" managed="false" visible="false" style="-fx-padding:20;">
                <ProgressIndicator style="-fx-progress-color:#3B82F6;" prefWidth="40" prefHeight="40" />
                <Label style="-fx-text-fill:#6B7280;-fx-font-size:13px;-fx-padding:0 0 0 12;" text="Loading exercises..." />
            </HBox>

            <!-- Results grid -->
            <VBox fx:id="resultsContainer" spacing="0.0" />

            <!-- Pagination -->
            <HBox fx:id="paginationBox" spacing="12.0" alignment="CENTER" managed="false" visible="false">
                <Button fx:id="prevBtn" mnemonicParsing="false" onAction="#onPrev"
                        style="-fx-background-color:#1F2937;-fx-border-color:#374151;-fx-border-radius:12;-fx-background-radius:12;-fx-text-fill:#9CA3AF;-fx-font-weight:700;-fx-font-size:13px;-fx-padding:8 20;-fx-cursor:hand;"
                        text="← Previous" />
                <Label fx:id="pageLabel"
                       style="-fx-text-fill:#6B7280;-fx-font-size:13px;-fx-font-weight:700;" text="Page 1" />
                <Button fx:id="nextBtn" mnemonicParsing="false" onAction="#onNext"
                        style="-fx-background-color:#1F2937;-fx-border-color:#374151;-fx-border-radius:12;-fx-background-radius:12;-fx-text-fill:#9CA3AF;-fx-font-weight:700;-fx-font-size:13px;-fx-padding:8 20;-fx-cursor:hand;"
                        text="Next →" />
            </HBox>

        </VBox>
    </ScrollPane>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" minHeight="620.0" minWidth="980.0" prefHeight="620.0" prefWidth="980.0"
           styleClass="signin-root" stylesheets="@../css/signin.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.ResetPasswordController">
   <children>

      <VBox alignment="CENTER" maxWidth="440.0" spacing="0" styleClass="signin-card">

         <!-- ── Form box ── -->
         <VBox fx:id="formBox" alignment="TOP_LEFT" spacing="10.0">
            <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>
            <children>
               <Button mnemonicParsing="false" onAction="#onBackToSignIn"
                       styleClass="btn-home-back" text="←  Back to Sign In" />
               <Region prefHeight="20.0" />
               <Label styleClass="welcome-title" text="New Password" />
               <Label styleClass="welcome-subtitle" wrapText="true"
                      text="Choose a strong password for your account." />
               <Region prefHeight="20.0" />

               <Label styleClass="field-label" text="NEW PASSWORD" />
               <PasswordField fx:id="newPasswordField" promptText="New password"
                              styleClass="input-field" />
               <Label fx:id="newPasswordError" styleClass="form-error-label"
                      managed="false" visible="false" text="" />
               <Region prefHeight="8.0" />

               <Label styleClass="field-label" text="CONFIRM PASSWORD" />
               <PasswordField fx:id="confirmPasswordField" promptText="Confirm password"
                              styleClass="input-field" />
               <Label fx:id="confirmPasswordError" styleClass="form-error-label"
                      managed="false" visible="false" text="" />
               <Region prefHeight="16.0" />

               <Button fx:id="resetButton" mnemonicParsing="false" onAction="#onReset"
                       styleClass="btn-signin-password" text="RESET PASSWORD"
                       maxWidth="Infinity" />
            </children>
         </VBox>

         <!-- ── Success box ── -->
         <VBox fx:id="successBox" alignment="CENTER" managed="false" visible="false" spacing="18.0">
            <padding><Insets bottom="60.0" left="40.0" right="40.0" top="60.0" /></padding>
            <children>
               <Label styleClass="left-title" text="✅" />
               <Label styleClass="welcome-title" text="Password Updated" />
               <Label styleClass="welcome-subtitle" alignment="CENTER" wrapText="true"
                      text="Your password has been reset. Redirecting you to Sign In..." />
               <Region prefHeight="10.0" />
               <HBox alignment="CENTER">
                  <Label styleClass="footer-text" text="Redirecting in 2 seconds..." />
               </HBox>
            </children>
         </VBox>

      </VBox>
   </children>
</StackPane>

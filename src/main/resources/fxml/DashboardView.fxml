<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root"
           prefHeight="700.0"
           prefWidth="1100.0"
           styleClass="dash-root"
           stylesheets="@../css/dashboard.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.DashboardController">

   <children>
      <BorderPane>

         <left>
            <VBox prefWidth="250.0" spacing="14.0" styleClass="dash-sidebar">
               <children>
                  <Label styleClass="dash-brand" text="FITSENSE" />
                  <Label styleClass="dash-side-sub" text="YOUR SPACE" />

                  <Button fx:id="dashHomeBtn" onAction="#onShowDashboard" styleClass="dash-side-link" text="&#x25C8;  Dashboard" />
                  <Button fx:id="dashProfileBtn" onAction="#onShowProfile" styleClass="dash-side-link" text="&#x263A;  Profile" />
                  <Button fx:id="dashWorkoutsBtn" onAction="#onShowWorkouts" styleClass="dash-side-link" text="&#x1F3CB;  My Workouts" />
                  <Button fx:id="dashMentalHealthBtn" onAction="#onShowMentalHealth" styleClass="dash-side-link" text="&#x1F9E0;  Mental Health" />
                  <Button fx:id="dashNutritionBtn" onAction="#onShowNutrition" styleClass="dash-side-link" text="&#x1F957;  Nutrition" />
                  <Button fx:id="dashChatroomBtn" onAction="#onShowChatroom" styleClass="dash-side-link" text="&#x1F4AC;  Chatroom" />

                  <Region VBox.vgrow="ALWAYS" />

                  <Button onAction="#onLogout" styleClass="dash-side-link" text="&#x23FB;  Sign Out" />
               </children>

               <padding>
                  <Insets bottom="22" left="18" right="18" top="22" />
               </padding>
            </VBox>
         </left>

         <center>
            <VBox styleClass="dash-main-area" VBox.vgrow="ALWAYS">
               <children>

                  <HBox alignment="CENTER_LEFT" styleClass="dash-navbar">
                     <children>
                        <!-- Logo and Title Section -->
                        <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS">
                           <children>
                              <ImageView fx:id="navbarLogoImage" fitHeight="32.0" fitWidth="32.0" preserveRatio="true" smooth="true">
                                 <image>
                                    <javafx.scene.image.Image url="file:C:/xampp2/htdocs/pidevassets/sport-hero.png" />
                                 </image>
                              </ImageView>
                              <VBox spacing="4">
                                 <children>
                                    <Label fx:id="navbarPageTitle" styleClass="dash-navbar-title" text="Dashboard" />
                                    <Label fx:id="navbarPageSubtitle" styleClass="dash-navbar-subtitle" text="Your fitness overview" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <StackPane>
                           <Button fx:id="navbarBellBtn"
                                   focusTraversable="false"
                                   onAction="#onShowNotifications"
                                   styleClass="dash-navbar-bell"
                                   text="&#x1F514;" />

                           <Label fx:id="notificationBadge"
                                  text="1"
                                  visible="false"
                                  managed="false"
                                  styleClass="notification-badge"
                                  StackPane.alignment="TOP_RIGHT"/>
                        </StackPane>

                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="dash-navbar-profile">
                           <children>
                              <VBox alignment="CENTER_LEFT" spacing="2">
                                 <children>
                                    <Label fx:id="navbarUserName" styleClass="dash-navbar-user-name" text="&#x2014;" />
                                    <Label fx:id="navbarUserRole" styleClass="dash-navbar-user-role" text="User" />
                                 </children>
                              </VBox>

                              <Label fx:id="navbarAvatar" alignment="CENTER" styleClass="dash-navbar-avatar" text="?" />
                           </children>
                        </HBox>
                     </children>

                     <padding>
                        <Insets bottom="16" left="24" right="24" top="16" />
                     </padding>
                  </HBox>

                  <ScrollPane fitToWidth="true"
                              hbarPolicy="NEVER"
                              vbarPolicy="AS_NEEDED"
                              styleClass="main-scroll"
                              VBox.vgrow="ALWAYS">
                     <content>
                        <StackPane styleClass="dash-center-stack">
                           <children>

                              <VBox fx:id="dashHomePane" spacing="18" styleClass="dash-content">
                                 <children>
                                    <VBox spacing="10" styleClass="hero-card">
                                       <children>
                                          <Label fx:id="welcomeLabel" styleClass="hero-title" text="Welcome back!" />

                                          <Label styleClass="hero-subtitle"
                                                 text="Ready to crush your goals today? Your plan is waiting for you."
                                                 wrapText="true" />

                                          <HBox spacing="10">
                                             <children>
                                                <Button styleClass="hero-primary-btn" text="Start Training" />
                                                <Button styleClass="hero-secondary-btn" text="Mental Check" />
                                             </children>
                                          </HBox>
                                       </children>

                                       <padding>
                                          <Insets bottom="18" left="20" right="20" top="18" />
                                       </padding>
                                    </VBox>

                                    <fx:include fx:id="dashNutritionStats" source="NutritionStatsFragment.fxml" />
                                 </children>

                                 <padding>
                                    <Insets bottom="22" left="22" right="22" top="22" />
                                 </padding>
                              </VBox>

                              <VBox fx:id="dashProfilePane"
                                    alignment="TOP_CENTER"
                                    managed="false"
                                    visible="false"
                                    styleClass="dash-content">
                                 <children>
                                    <fx:include fx:id="dashProfile" source="ProfileFragment.fxml" />
                                 </children>

                                 <padding>
                                    <Insets bottom="22" left="22" right="22" top="22" />
                                 </padding>
                              </VBox>

                              <VBox fx:id="dashNutritionPane"
                                    managed="false"
                                    visible="false"
                                    spacing="0"
                                    styleClass="dash-content">
                                 <children>
                                    <fx:include source="NutritionFragment.fxml" />
                                 </children>

                                 <padding>
                                    <Insets bottom="22" left="22" right="22" top="22" />
                                 </padding>
                              </VBox>

                              <VBox fx:id="dashWorkoutsPane"
                                    managed="false"
                                    visible="false"
                                    spacing="0"
                                    styleClass="dash-content"
                                    VBox.vgrow="ALWAYS">
                                 <children>
                                    <VBox fx:id="workoutsFragmentPane" VBox.vgrow="ALWAYS">
                                       <children>
                                          <fx:include fx:id="dashWorkouts" source="UserWorkoutsFragment.fxml" VBox.vgrow="ALWAYS" />
                                       </children>
                                    </VBox>
                                    <VBox fx:id="libraryPane" managed="false" visible="false" VBox.vgrow="ALWAYS" />
                                 </children>
                              </VBox>

                              <VBox fx:id="dashActivityPane"
                                    managed="false"
                                    visible="false"
                                    spacing="0"
                                    styleClass="dash-content"
                                    VBox.vgrow="ALWAYS">
                                 <children>
                                    <fx:include fx:id="dashActivity" source="ActivityLogView.fxml" VBox.vgrow="ALWAYS" />
                                 </children>
                              </VBox>

                              <VBox fx:id="dashMentalHealthPane"
                                    managed="false"
                                    visible="false"
                                    spacing="0"
                                    styleClass="dash-content"
                                    VBox.vgrow="ALWAYS">
                                 <children>
                                    <fx:include fx:id="dashMentalHealth" source="MentalHealthUserFragment.fxml" VBox.vgrow="ALWAYS" />
                                 </children>
                              </VBox>

                              <VBox fx:id="dashChatroomPane"
                                    managed="false"
                                    visible="false"
                                    spacing="0"
                                    styleClass="dash-content"
                                    VBox.vgrow="ALWAYS">
                                 <children>
                                    <fx:include fx:id="dashChatroom" source="ChatroomFragment.fxml" VBox.vgrow="ALWAYS" />
                                 </children>
                              </VBox>

                           </children>
                        </StackPane>
                     </content>
                  </ScrollPane>

               </children>
            </VBox>
         </center>

      </BorderPane>
   </children>
</StackPane>
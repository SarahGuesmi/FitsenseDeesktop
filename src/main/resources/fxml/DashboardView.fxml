<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="700.0" prefWidth="1100.0" styleClass="dash-root" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DashboardController">
   <children>
      <BorderPane>
         <left>
            <VBox prefWidth="210.0" spacing="14.0" styleClass="dash-sidebar">
               <children>
                  <Label fx:id="userNameLabel" styleClass="sidebar-user" text="User" />
                  <Label styleClass="sidebar-brand" text="FITSENSE" />
                  <Button mnemonicParsing="false" styleClass="side-item-active" text="Dashboard" />
                  <Button mnemonicParsing="false" styleClass="side-item" text="My Workouts" />
                  <Button mnemonicParsing="false" styleClass="side-item" text="Mental Health" />
                  <Button mnemonicParsing="false" styleClass="side-item" text="Nutrition" />
                  <Button mnemonicParsing="false" styleClass="side-item" text="Chatroom" />
                  <Button mnemonicParsing="false" onAction="#onLogout" styleClass="logout-btn" text="Logout" />
               </children>
               <padding>
                  <Insets bottom="20.0" left="14.0" right="14.0" top="20.0" />
               </padding>
            </VBox>
         </left>
         <center>
            <VBox spacing="18.0" styleClass="dash-content">
               <children>
                  <Label styleClass="dash-page-title" text="My Dashboard" />
                  <VBox spacing="10.0" styleClass="hero-card">
                     <children>
                        <Label fx:id="welcomeLabel" styleClass="hero-title" text="Welcome back!" />
                        <Label styleClass="hero-subtitle" text="Ready to crush your goals today? Your plan is waiting for you." wrapText="true" />
                        <HBox spacing="10.0">
                           <children>
                              <Button mnemonicParsing="false" styleClass="hero-primary-btn" text="Start Training" />
                              <Button mnemonicParsing="false" styleClass="hero-secondary-btn" text="Mental Check" />
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
                     </padding>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
               </padding>
            </VBox>
         </center>
      </BorderPane>
   </children>
</StackPane>

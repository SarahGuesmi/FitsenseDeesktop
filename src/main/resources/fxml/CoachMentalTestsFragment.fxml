<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="cm-scroll" stylesheets="@../css/coach-mental-tests.css" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CoachMentalTestsFragmentController">
   <content>
      <HBox alignment="TOP_CENTER" maxWidth="Infinity" styleClass="cm-outer">
         <children>
            <StackPane maxWidth="960.0" minWidth="400.0" styleClass="cm-stack">
               <children>
                  <VBox fx:id="listPane" spacing="16.0" styleClass="cm-root">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                           <children>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="cm-page-title" text="Mental wellbeing tests" />
                                    <Label styleClass="cm-page-subtitle" text="Define tests for members. Each question is scored 1–5; total score is the sum (max = 5 × number of questions)." wrapText="true" />
                                 </children>
                              </VBox>
                              <Button mnemonicParsing="false" onAction="#onCreateTest" styleClass="cm-primary-btn" text="+ Create test" />
                           </children>
                        </HBox>
                        <TableView fx:id="testsTable" minHeight="280.0" styleClass="cm-table" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colTitle" prefWidth="280.0" text="Title" />
                              <TableColumn fx:id="colQuestionCount" prefWidth="100.0" text="Questions" />
                              <TableColumn fx:id="colMaxScore" prefWidth="100.0" text="Max score" />
                              <TableColumn fx:id="colAction" prefWidth="180.0" text="Actions" />
                           </columns>
                        </TableView>
                     </children>
                     <padding>
                        <Insets bottom="8.0" left="4.0" right="4.0" top="4.0" />
                     </padding>
                  </VBox>
                  <VBox fx:id="formPane" managed="false" spacing="16.0" styleClass="cm-root" visible="false">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Button mnemonicParsing="false" onAction="#onBackToList" styleClass="cm-secondary-btn" text="←  Back to tests" />
                           </children>
                        </HBox>
                        <Label fx:id="formHeadingLabel" styleClass="cm-form-heading" text="New test" />
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="cm-field-label" text="Test title" />
                              <TextField fx:id="titleField" promptText="e.g. Weekly wellbeing check" styleClass="cm-text-field" />
                           </children>
                        </VBox>
                        <VBox spacing="8.0">
                           <children>
                              <Label styleClass="cm-field-label" text="Questions" />
                              <Label styleClass="cm-hint" text="Members will pick 1–5 per question. Scoring matches the member mental check-in (sum of all answers)." wrapText="true" />
                              <VBox fx:id="questionsEditorBox" spacing="10.0" styleClass="cm-questions-box" />
                              <Button mnemonicParsing="false" onAction="#onAddQuestionRow" styleClass="cm-outline-btn" text="+ Add question" />
                           </children>
                        </VBox>
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#onBackToList" styleClass="cm-secondary-btn" text="Cancel" />
                              <Button mnemonicParsing="false" onAction="#onSaveTest" styleClass="cm-primary-btn" text="Save test" />
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="8.0" left="4.0" right="4.0" top="4.0" />
                     </padding>
                  </VBox>
               </children>
            </StackPane>
         </children>
      </HBox>
   </content>
</ScrollPane>

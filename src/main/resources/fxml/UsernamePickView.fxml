<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="620.0" prefWidth="980.0" styleClass="onb-root"
           stylesheets="@../css/onboarding.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.UsernamePickController">
   <children>
      <VBox alignment="CENTER" maxWidth="640.0" spacing="10.0">
         <children>

            <!-- Header -->
            <Label styleClass="onb-title" text="Claim Your Identity" />
            <Label styleClass="onb-subtitle" wrapText="true" alignment="CENTER"
                   text="AI has brainstormed some unique handles for your fitness journey" />
            <Region prefHeight="10.0" />

            <!-- Regenerate -->
            <HBox alignment="CENTER">
               <Button fx:id="regenerateBtn" mnemonicParsing="false" onAction="#onRegenerate"
                       styleClass="username-regen-btn" text="⟳  Regenerate Options" />
            </HBox>
            <Region prefHeight="8.0" />

            <!-- Loading label -->
            <Label fx:id="loadingLabel" styleClass="onb-subtitle" text="✨ Generating usernames..."
                   managed="false" visible="false" />

            <!-- Username chips -->
            <FlowPane fx:id="chipsPane" hgap="12.0" vgap="12.0" alignment="CENTER"
                      prefWrapLength="600.0" />

            <Region prefHeight="16.0" />

            <!-- Custom input -->
            <VBox styleClass="username-custom-box" spacing="10.0" alignment="CENTER">
               <padding><Insets bottom="20.0" left="24.0" right="24.0" top="16.0"/></padding>
               <children>
                  <Label styleClass="username-custom-label" text="DIDN'T LIKE THESE? CREATE YOUR OWN" />
                  <TextField fx:id="customField" promptText="Enter custom handle..."
                             styleClass="username-custom-input" maxWidth="340.0" />
               </children>
            </VBox>

            <Region prefHeight="10.0" />

            <!-- Confirm -->
            <HBox alignment="CENTER" maxWidth="340.0" spacing="12.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onBack" styleClass="btn-back" text="← Back" />
                  <Button fx:id="confirmBtn" maxWidth="Infinity" mnemonicParsing="false" onAction="#onConfirm" prefHeight="48.0" styleClass="btn-continue" text="CONFIRM &amp; CONTINUE" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <Label fx:id="errorLabel" styleClass="username-error" managed="false" visible="false" text="" />

         </children>
         <padding><Insets bottom="32.0" left="32.0" right="32.0" top="32.0"/></padding>
      </VBox>
   </children>
</StackPane>

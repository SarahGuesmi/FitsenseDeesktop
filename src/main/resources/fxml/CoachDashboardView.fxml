<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700.0" prefWidth="1100.0" styleClass="admin-root" stylesheets="@../css/admin.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CoachDashboardController">
   <children>
      <BorderPane>
         <left>
            <VBox prefWidth="250.0" spacing="10.0" styleClass="admin-sidebar">
               <children>
                  <HBox alignment="CENTER">
                     <StackPane alignment="CENTER" styleClass="sidebar-avatar-frame">
                        <children>
                           <ImageView fx:id="sidebarAvatarView" fitHeight="72.0" fitWidth="72.0"
                                      preserveRatio="true" smooth="true" />
                           <Label fx:id="sidebarAvatarInitials" styleClass="sidebar-avatar-initials" text="?" />
                        </children>
                     </StackPane>
                  </HBox>
                  <Label styleClass="admin-brand" text="FITSENSE" />
                  <Label styleClass="admin-side-sub" text="COACH PANEL" />
                  <Button fx:id="coachHomeBtn" mnemonicParsing="false" onAction="#onShowDashboard" styleClass="side-link" text="◈  Dashboard" />
                  <Button fx:id="athletesBtn" mnemonicParsing="false" onAction="#onShowAthletes" styleClass="side-link" text="◎  Athletes" />
                  <Button fx:id="chatroomBtn" mnemonicParsing="false" onAction="#onShowChatroom" styleClass="side-link" text="💬  Chatroom" />
                  <Button fx:id="workoutCatalogBtn" mnemonicParsing="false" onAction="#onShowWorkoutCatalog" styleClass="side-link" text="🏋  Workout catalog" />
                  <Button fx:id="feedbackBtn" mnemonicParsing="false" onAction="#onShowFeedback" styleClass="side-link" text="✉  Feedback management" />
                  <Label styleClass="coach-side-section" text="MENTAL WELLNESS" />
                  <Button fx:id="mentalTestsBtn" mnemonicParsing="false" onAction="#onShowMentalTests" styleClass="side-sub-link" text="◇  Tests &amp; questionnaires" />
                  <Button fx:id="mentalAssessmentsBtn" mnemonicParsing="false" onAction="#onShowMentalAssessments" styleClass="side-sub-link" text="◇  Latest assessments" />
                  <Button fx:id="nutritionBtn" mnemonicParsing="false" onAction="#onShowNutrition" styleClass="side-link" text="🥗  Nutrition plan" />
                  <Button fx:id="profileBtn" mnemonicParsing="false" onAction="#onShowProfile" styleClass="side-link" text="☺  Profile" />
                  <Button fx:id="securityBtn" mnemonicParsing="false" onAction="#onShowSecurity" styleClass="side-link" text="🔐  Security" />
                  <Button mnemonicParsing="false" onAction="#onLogout" styleClass="side-link" text="⏻  Sign Out" />
               </children>
               <padding>
                  <Insets bottom="22.0" left="18.0" right="18.0" top="22.0" />
               </padding>
            </VBox>
         </left>
         <center>
            <VBox styleClass="admin-main-area" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" styleClass="admin-navbar" VBox.vgrow="NEVER">
                     <children>
                        <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                           <children>
                              <Label fx:id="navbarPageTitle" styleClass="navbar-page-title" text="Coach dashboard" />
                              <Label fx:id="navbarPageSubtitle" styleClass="navbar-page-subtitle" text="Train and support your athletes" />
                           </children>
                        </VBox>
                        <Button fx:id="navbarBellBtn" focusTraversable="false" mnemonicParsing="false" styleClass="navbar-bell-btn" text="" />
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="navbar-profile">
                           <children>
                              <VBox alignment="CENTER_LEFT" spacing="2.0">
                                 <children>
                                    <Label fx:id="navbarUserName" styleClass="navbar-user-name" text="—" />
                                    <Label fx:id="navbarUserRole" styleClass="navbar-user-role" text="Coach" />
                                 </children>
                              </VBox>
                              <Label fx:id="navbarAvatar" alignment="CENTER" styleClass="navbar-avatar" text="C" />
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
                     </padding>
                  </HBox>
                  <StackPane styleClass="admin-center-stack" VBox.vgrow="ALWAYS">
                     <children>                        <VBox fx:id="coachDashboardPane" spacing="14.0" styleClass="admin-content">
                           <children>
                              <Label styleClass="page-title" text="Overview" />
                              <!-- Stat cards row -->
                              <HBox spacing="14.0">
                                 <children>
                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="stat-title" text="ATHLETES IN ROSTER" />
                                          <Label fx:id="totalAthletesLabel" styleClass="stat-value" text="0" />
                                       </children>
                                       <padding><Insets bottom="12.0" left="14.0" right="14.0" top="12.0" /></padding>
                                    </VBox>
                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="stat-title" text="ACTIVE ATHLETES" />
                                          <Label fx:id="activeAthletesLabel" styleClass="stat-value" text="0" />
                                       </children>
                                       <padding><Insets bottom="12.0" left="14.0" right="14.0" top="12.0" /></padding>
                                    </VBox>
                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="stat-title" text="TOTAL FEEDBACKS" />
                                          <Label fx:id="sessionsLabel" styleClass="stat-value" text="0" />
                                       </children>
                                       <padding><Insets bottom="12.0" left="14.0" right="14.0" top="12.0" /></padding>
                                    </VBox>
                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="stat-title" text="POSITIVE SENTIMENT" />
                                          <Label fx:id="positiveSentimentLabel" styleClass="stat-value" text="0%" />
                                       </children>
                                       <padding><Insets bottom="12.0" left="14.0" right="14.0" top="12.0" /></padding>
                                    </VBox>
                                 </children>
                              </HBox>

                              <!-- Charts row -->
                              <HBox spacing="14.0">
                                 <children>
                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8.0">
                                       <children>
                                          <Label styleClass="stat-title" text="RÉPARTITION SATISFAITS" />
                                          <VBox fx:id="ratingChartContainer" prefHeight="200.0" />
                                       </children>
                                       <padding><Insets bottom="12.0" left="14.0" right="14.0" top="12.0" /></padding>
                                    </VBox>
                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8.0">
                                       <children>
                                          <Label styleClass="stat-title" text="INTENSITÉ DES FEEDBACKS" />
                                          <VBox fx:id="sentimentChartContainer" prefHeight="200.0" />
                                       </children>
                                       <padding><Insets bottom="12.0" left="14.0" right="14.0" top="12.0" /></padding>
                                    </VBox>
                                 </children>
                              </HBox>

                              <!-- Recent feedbacks table -->
                              <Label styleClass="page-title" text="Derniers feedbacks réels" />
                              <TableView fx:id="dashFeedbackTable" prefHeight="200.0" styleClass="users-table">
                                 <columns>
                                    <TableColumn fx:id="dashUserCol" text="USER" prefWidth="180.0" />
                                    <TableColumn fx:id="dashWorkoutCol" text="WORKOUT" prefWidth="180.0" />
                                    <TableColumn fx:id="dashRatingCol" text="RATING" prefWidth="120.0" />
                                    <TableColumn fx:id="dashSentimentCol" text="SENTIMENT" prefWidth="120.0" />
                                    <TableColumn fx:id="dashCommentCol" text="COMMENT" prefWidth="260.0" />
                                    <TableColumn fx:id="dashDateCol" text="DATE" prefWidth="150.0" />
                                 </columns>
                              </TableView>
                           </children>
                           <padding><Insets bottom="18.0" left="18.0" right="18.0" top="18.0" /></padding>
                        </VBox>
                        <VBox fx:id="athletesPane" managed="false" spacing="14.0" styleClass="admin-content" visible="false">
                           <children>
                              <HBox alignment="CENTER_LEFT" styleClass="users-header">
                                 <children>
                                    <VBox HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="users-title" text="Athletes" />
                                          <Label styleClass="users-subtitle" text="Users in the system (read-only)" />
                                       </children>
                                    </VBox>
                                 </children>
                                 <padding>
                                    <Insets bottom="8.0" left="2.0" right="2.0" top="2.0" />
                                 </padding>
                              </HBox>
                              <TableView fx:id="athletesTable" prefHeight="520.0" styleClass="users-table">
                                 <columns>
                                    <TableColumn fx:id="nameCol" text="User" prefWidth="300.0" />
                                    <TableColumn fx:id="roleCol" text="Function" prefWidth="150.0" />
                                    <TableColumn fx:id="statusCol" text="Status" prefWidth="150.0" />
                                    <TableColumn fx:id="dateCol" text="Date creation" prefWidth="150.0" />
                                 </columns>
                              </TableView>
                           </children>
                           <padding>
                              <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                           </padding>
                        </VBox>
                        <VBox fx:id="chatroomPane" managed="false" spacing="0" styleClass="admin-content" visible="false" VBox.vgrow="ALWAYS">
                           <children>
                              <fx:include fx:id="chatroom" source="ChatroomFragment.fxml" VBox.vgrow="ALWAYS" />
                           </children>
                        </VBox>
                        <VBox fx:id="workoutCatalogPane" managed="false" styleClass="admin-content" visible="false" VBox.vgrow="ALWAYS">
                           <children>
                              <fx:include fx:id="workoutCatalog" source="WorkoutCatalogFragment.fxml" VBox.vgrow="ALWAYS" />
                           </children>
                        </VBox>
                        <VBox fx:id="feedbackPane" managed="false" spacing="18.0" styleClass="admin-content" visible="false" VBox.vgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="14.0">
                                 <children>
                                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                                       <children>
                                          <Label styleClass="page-title" text="Feedback Management" />
                                          <Label styleClass="users-subtitle" text="Create and manage feedback questionnaires for your athletes." />
                                       </children>
                                    </VBox>
                                    <Button mnemonicParsing="false" onAction="#onAddFeedback" styleClass="btn-add-primary" text="+ Add Feedback" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="search-bar-box">
                                 <children>
                                    <Label styleClass="search-icon" text="🔍" />
                                    <TextField fx:id="feedbackSearchField" promptText="Search by title..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                              <TableView fx:id="feedbackTable" prefHeight="260.0" styleClass="users-table">
                                 <columns>
                                    <TableColumn fx:id="feedbackTitleCol" text="TITLE" prefWidth="320.0" />
                                    <TableColumn fx:id="feedbackWorkoutsCol" text="LINKED WORKOUTS" prefWidth="260.0" />
                                    <TableColumn fx:id="feedbackOptionsCol" text="OPTIONS" prefWidth="160.0" />
                                    <TableColumn fx:id="feedbackActionsCol" text="ACTIONS" prefWidth="140.0" />
                                 </columns>
                              </TableView>

                              <!-- Recent Feedback responses -->
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label styleClass="page-title" text="Recent Feedback" />
                                    <Label fx:id="responsesCountLabel" styleClass="responses-badge" text="0 responses" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button mnemonicParsing="false" onAction="#onSendDailyReport" styleClass="btn-send-report" text="✉  Send Daily Report" />
                                 </children>
                              </HBox>
                              <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                                 <content>
                                    <VBox fx:id="responsesContainer" spacing="14.0">
                                       <padding><Insets bottom="10.0" right="4.0" /></padding>
                                    </VBox>
                                 </content>
                              </ScrollPane>
                           </children>
                           <padding>
                              <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                           </padding>
                        </VBox>
                        <VBox fx:id="mentalTestsPane" managed="false" spacing="0.0" styleClass="admin-content" visible="false" VBox.vgrow="ALWAYS">
                           <children>
                              <fx:include fx:id="coachMentalTests" source="CoachMentalTestsFragment.fxml" VBox.vgrow="ALWAYS" />
                           </children>
                           <padding>
                              <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                           </padding>
                        </VBox>
                        <VBox fx:id="mentalAssessmentsPane" managed="false" spacing="0.0" styleClass="admin-content" visible="false" VBox.vgrow="ALWAYS">
                           <children>
                              <fx:include fx:id="coachMentalAssessments" source="CoachMentalAssessmentsFragment.fxml" VBox.vgrow="ALWAYS" />
                           </children>
                           <padding>
                              <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                           </padding>
                        </VBox>
                        <VBox fx:id="nutritionPane"
                              managed="false"
                              visible="false"
                              spacing="0"
                              styleClass="admin-content"
                              VBox.vgrow="ALWAYS">

                           <children>
                              <fx:include source="RecipeCatalogFragment.fxml"/>
                           </children>

                           <padding>
                              <Insets top="18" right="18" bottom="18" left="18"/>
                           </padding>

                        </VBox>
                        <VBox fx:id="profilePane" managed="false" spacing="0.0" styleClass="admin-content" visible="false" VBox.vgrow="ALWAYS">
                           <children>
                              <fx:include fx:id="coachProfile" source="ProfileFragment.fxml" VBox.vgrow="ALWAYS" />
                           </children>
                           <padding>
                              <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                           </padding>
                        </VBox>
                        <ScrollPane fx:id="securityPane" managed="false" visible="false"
                                    fitToWidth="true" styleClass="admin-content tfa-scroll-pane" VBox.vgrow="ALWAYS">
                           <content>
                              <fx:include fx:id="coachSecurity" source="TwoFactorSetupFragment.fxml" />
                           </content>
                        </ScrollPane>
                     </children>
                  </StackPane>
               </children>
            </VBox>
         </center>
      </BorderPane>

      <!-- Modal overlay for Add/Edit Feedback -->
      <StackPane fx:id="feedbackModalOverlay" managed="false" styleClass="modal-overlay" visible="false" maxWidth="Infinity" maxHeight="Infinity">
         <children>
            <ScrollPane fx:id="feedbackModalScroll" fitToWidth="true" maxHeight="580.0" maxWidth="560.0" styleClass="modal-scroll">
               <content>
                  <VBox spacing="18.0" styleClass="modal-card">
                     <padding><Insets bottom="28.0" left="28.0" right="28.0" top="24.0" /></padding>
                     <children>
                        <!-- Header -->
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="modal-title" text="Add New Feedback" HBox.hgrow="ALWAYS" />
                              <Button mnemonicParsing="false" onAction="#onCloseFeedbackModal" styleClass="modal-close-btn" text="✕" />
                           </children>
                        </HBox>
                        <Separator />

                        <!-- Feedback Title -->
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="field-label-blue" text="Feedback Title" />
                              <TextField fx:id="modalTitreField" promptText="e.g. Session Evaluation" styleClass="modal-field" />
                              <Label fx:id="modalTitreErrorLabel" styleClass="field-error-label" text="Feedback title is required." visible="false" wrapText="true" />
                           </children>
                        </VBox>

                        <!-- Linked Workouts -->
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="field-label-blue" text="Linked Workouts (Select at least one)" />
                              <ScrollPane fitToWidth="true" prefHeight="180.0" styleClass="modal-scroll">
                                 <content>
                                    <VBox fx:id="workoutsCheckboxList" spacing="8.0" styleClass="modal-card-compact">
                                       <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0" /></padding>
                                    </VBox>
                                 </content>
                              </ScrollPane>
                              <Label fx:id="workoutsErrorLabel" styleClass="field-error-label" text="Please select at least one workout." visible="false" wrapText="true" />
                           </children>
                        </VBox>

                        <!-- Response Options -->
                        <VBox spacing="8.0">
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label styleClass="field-label-blue" text="Response Options" HBox.hgrow="ALWAYS" />
                                    <Button mnemonicParsing="false" onAction="#onAddOption" styleClass="side-link" text="+ Add Option" />
                                 </children>
                              </HBox>
                              <VBox fx:id="optionsList" spacing="8.0" />
                           </children>
                        </VBox>

                        <!-- Actions -->
                        <HBox alignment="CENTER" spacing="16.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#onCloseFeedbackModal" styleClass="modal-btn-cancel" text="Cancel" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                              <Button mnemonicParsing="false" onAction="#onSaveFeedbackModal" styleClass="modal-btn-primary" text="Save Changes" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </StackPane>

      <!-- Delete confirmation modal -->
      <StackPane fx:id="deleteConfirmOverlay" managed="false" visible="false" styleClass="modal-overlay" maxWidth="Infinity" maxHeight="Infinity">
         <children>
            <VBox alignment="CENTER" spacing="20.0" styleClass="modal-card" maxWidth="420.0">
               <padding><Insets bottom="32.0" left="32.0" right="32.0" top="28.0" /></padding>
               <children>
                  <StackPane alignment="CENTER">
                     <children>
                        <Label alignment="CENTER" styleClass="delete-icon-circle" text="⚠" />
                     </children>
                  </StackPane>
                  <Label alignment="CENTER" styleClass="modal-title" text="Delete Feedback?" />
                  <Label alignment="CENTER" maxWidth="320.0" styleClass="users-subtitle" text="This action is irreversible. Do you really want to delete this questionnaire?" textAlignment="CENTER" wrapText="true" />
                  <HBox alignment="CENTER" spacing="16.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#onCancelDelete" styleClass="modal-btn-cancel" text="Cancel" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        <Button mnemonicParsing="false" onAction="#onConfirmDelete" styleClass="modal-btn-danger" text="Delete" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>

      <!-- Logout confirmation overlay -->
      <StackPane fx:id="logoutOverlay" managed="false" visible="false" styleClass="modal-overlay" maxWidth="Infinity" maxHeight="Infinity">
         <children>
            <VBox alignment="CENTER" spacing="12.0" styleClass="modal-card" maxWidth="380.0" maxHeight="220.0">
               <padding><Insets bottom="24.0" left="28.0" right="28.0" top="20.0" /></padding>
               <children>
                  <Label alignment="CENTER" styleClass="dash-logout-icon" text="⏻" />
                  <Label alignment="CENTER" styleClass="modal-title" text="Sign Out" />
                  <Label alignment="CENTER" maxWidth="300.0" styleClass="users-subtitle" text="Are you sure you want to sign out?" textAlignment="CENTER" wrapText="true" />
                  <HBox alignment="CENTER" spacing="12.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#onCancelLogout" styleClass="modal-btn-cancel" text="Cancel" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        <Button mnemonicParsing="false" onAction="#onConfirmLogout" styleClass="modal-btn-danger" text="Sign Out" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>

   </children>
</StackPane>

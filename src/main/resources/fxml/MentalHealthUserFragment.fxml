<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="mh-scroll" stylesheets="@../css/mental-health.css" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MentalHealthUserFragmentController">
   <content>
      <HBox alignment="CENTER" maxWidth="Infinity" styleClass="mh-outer">
         <children>
            <StackPane maxWidth="900.0" minWidth="280.0" styleClass="mh-stack">
               <children>
                  <!-- List: recommendations first, then evaluations -->
                  <VBox fx:id="listPane" alignment="TOP_CENTER" spacing="20.0" styleClass="mh-root">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="mh-history-header">
                           <children>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <Label styleClass="mh-section-accent-bar" text="" />
                                          <Label styleClass="mh-section-title" text="Mental Health History" />
                                       </children>
                                    </HBox>
                                    <Label styleClass="mh-section-subtitle" text="Your coach recommendations and your check-ins." wrapText="true" />
                                 </children>
                              </VBox>
                              <Button mnemonicParsing="false" onAction="#onAddMentalHealth" styleClass="mh-add-btn" text="+ Add Mental Health" />
                           </children>
                        </HBox>
                        <VBox spacing="12.0" styleClass="mh-table-card">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label styleClass="mh-section-accent-bar" text="" />
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="mh-rec-section-title" text="Coach recommendations" />
                                          <Label styleClass="mh-rec-section-sub" text="Advice linked to your assessments. You can remove a row from your view anytime." wrapText="true" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <TableView fx:id="recommendationsTable" minHeight="160.0" styleClass="mh-rec-table" VBox.vgrow="NEVER">
                                 <columns>
                                    <TableColumn fx:id="colRecDate" prefWidth="150.0" text="Check-in" />
                                    <TableColumn fx:id="colRecTest" prefWidth="130.0" text="Test" />
                                    <TableColumn fx:id="colRecSummary" prefWidth="280.0" text="Recommendation" />
                                    <TableColumn fx:id="colRecAction" prefWidth="100.0" text="Action" />
                                 </columns>
                              </TableView>
                           </children>
                           <padding>
                              <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                           </padding>
                        </VBox>
                        <!-- Trend Analysis Card -->
                        <VBox spacing="10.0" styleClass="mh-trend-card">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label styleClass="mh-section-accent-bar" text="" />
                                    <Label styleClass="mh-trend-card-title" text="📈  Mental Health Trends" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <children>
                                    <Label fx:id="trendIconLabel" styleClass="mh-trend-icon" text="📊" />
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label fx:id="trendInfoLabel" styleClass="mh-trend-info" text="Analyzing your history…" wrapText="true" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <Label fx:id="trendInsightLabel" styleClass="mh-trend-insight" text="Loading insights…" wrapText="true" />
                           </children>
                           <padding>
                              <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                           </padding>
                        </VBox>
                        <VBox spacing="12.0" styleClass="mh-table-card" VBox.vgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label styleClass="mh-section-accent-bar" text="" />
                                    <Label styleClass="mh-section-title" text="Your Evaluations" />
                                 </children>
                              </HBox>
                              <TableView fx:id="evaluationsTable" minHeight="200.0" styleClass="mh-table" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colTestTitle" prefWidth="160.0" text="Test" />
                                    <TableColumn fx:id="colDate" prefWidth="150.0" text="Date of test" />
                                    <TableColumn fx:id="colScore" prefWidth="90.0" text="Score" />
                                    <TableColumn fx:id="colStatus" prefWidth="110.0" text="Status" />
                                    <TableColumn fx:id="colAction" prefWidth="160.0" text="Action" />
                                 </columns>
                              </TableView>
                           </children>
                           <padding>
                              <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                           </padding>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="24.0" left="8.0" right="8.0" top="8.0" />
                     </padding>
                  </VBox>
                  <!-- Form: after Add or Edit -->
                  <VBox fx:id="formPane" alignment="TOP_CENTER" managed="false" spacing="22.0" styleClass="mh-root" visible="false">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Button mnemonicParsing="false" onAction="#onBackToList" styleClass="mh-back-btn" text="←  Back to evaluations" />
                           </children>
                        </HBox>
                        <VBox spacing="8.0" styleClass="mh-header-card">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <children>
                                    <Label styleClass="mh-header-icon" text="🧠" />
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label fx:id="formHeaderTitle" styleClass="mh-title" text="Your Daily Check-in" />
                                          <Label fx:id="formHeaderSubtitle" styleClass="mh-subtitle" text="Choose a coach test, then answer each question" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                           <padding>
                              <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                           </padding>
                        </VBox>
                        <VBox spacing="8.0" styleClass="mh-question-block">
                           <children>
                              <Label styleClass="mh-question-label" text="📋  Select the assessment" wrapText="true" />
                              <ComboBox fx:id="testPicker" maxWidth="Infinity" minHeight="52.0" prefHeight="52.0" promptText="Choose a test…" styleClass="mh-combo" />
                           </children>
                        </VBox>
                        <VBox fx:id="dynamicQuestionsBox" spacing="12.0" />
                        <VBox spacing="8.0" styleClass="mh-question-block">
                           <children>
                              <Label styleClass="mh-question-label" text="💭  Tell us more about how you feel (optional)" wrapText="true" />
                              <TextArea fx:id="notesArea" maxWidth="Infinity" prefRowCount="4" promptText="Share your thoughts, feelings, or anything else on your mind..." styleClass="mh-textarea" wrapText="true" />
                           </children>
                        </VBox>
                        <!-- Weather + AI Advice Card -->
                        <VBox fx:id="weatherAdviceCard" spacing="10.0" styleClass="mh-weather-card">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label styleClass="mh-section-accent-bar" text="" />
                                    <Label styleClass="mh-weather-card-title" text="🌤  Today's Wellness Tip" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <children>
                                    <Label fx:id="weatherIconLabel" styleClass="mh-weather-icon" text="⏳" />
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label fx:id="weatherInfoLabel" styleClass="mh-weather-info" text="Fetching weather…" wrapText="true" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <Label fx:id="aiAdviceLabel" styleClass="mh-ai-advice" text="Getting personalised advice…" wrapText="true" />
                           </children>
                           <padding>
                              <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                           </padding>
                        </VBox>
                        <VBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Button fx:id="submitCheckInBtn" mnemonicParsing="false" onAction="#onCalculateWellbeing" styleClass="mh-primary-btn" text="Calculate My Wellbeing Score →" />
                              <Label styleClass="mh-disclaimer" text="Your data is used to provide personalized recommendations." wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="32.0" left="8.0" right="8.0" top="8.0" />
                     </padding>
                  </VBox>
               </children>
            </StackPane>
         </children>
      </HBox>
   </content>
</ScrollPane>

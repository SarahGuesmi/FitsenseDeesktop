<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" minHeight="620.0" minWidth="980.0" prefHeight="620.0" prefWidth="980.0"
           styleClass="signin-root" stylesheets="@../css/signin.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.TwoFactorVerifyController">
   <children>
      <VBox alignment="CENTER" maxWidth="400" spacing="0" styleClass="signin-card">
         <padding><Insets bottom="48" left="40" right="40" top="48"/></padding>
         <children>

            <!-- Gradient Icon Container -->
            <StackPane styleClass="tfa-verify-icon-container">
               <children>
                  <Label styleClass="tfa-verify-icon" text="🔐" />
               </children>
            </StackPane>
            <Region prefHeight="32" />
            
            <!-- Title -->
            <Label styleClass="welcome-title" text="Secure Access" />
            <Region prefHeight="12" />
            <Label styleClass="welcome-subtitle" wrapText="true" alignment="CENTER"
                   text="Enter the 6-digit verification code from your authenticator app to continue." />
            <Region prefHeight="40" />

            <!-- Code input -->
            <TextField fx:id="codeField" promptText="0 0 0 0 0 0" styleClass="tfa-verify-input"
                       maxWidth="320" />
            <Label fx:id="codeError" styleClass="form-error-label" managed="false" visible="false" text="" />
            <Region prefHeight="32" />

            <!-- Verify button -->
            <Button fx:id="verifyBtn" mnemonicParsing="false" onAction="#onVerify"
                    styleClass="btn-signin-password" text="VERIFY IDENTITY" maxWidth="320" />
            <Region prefHeight="24" />

            <!-- Back link -->
            <HBox alignment="CENTER">
               <children>
                  <Button mnemonicParsing="false" onAction="#onBackToSignIn"
                          styleClass="btn-signup-inline" text="⟲ Cancel and Logout" />
               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</StackPane>

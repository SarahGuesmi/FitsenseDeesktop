<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<StackPane prefHeight="700.0" prefWidth="1100.0"
           styleClass="admin-root"
           stylesheets="@../css/admin.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.CoachDashboardController">

   <children>
      <BorderPane>

         <left>
            <VBox prefWidth="250.0" spacing="10.0" styleClass="admin-sidebar">
               <children>
                  <Label styleClass="admin-brand" text="FITSENSE" />
                  <Label styleClass="admin-side-sub" text="COACH PANEL" />

                  <Button fx:id="coachHomeBtn" text="&#x25C8;  Dashboard" styleClass="side-link" onAction="#onShowDashboard" />
                  <Button fx:id="athletesBtn" text="&#x25CE;  Athletes" styleClass="side-link" onAction="#onShowAthletes" />
                  <Button fx:id="chatroomBtn" text="&#x1F4AC;  Chatroom" styleClass="side-link" onAction="#onShowChatroom" />
                  <Button fx:id="workoutCatalogBtn" text="&#x1F3CB;  Workout catalog" styleClass="side-link" onAction="#onShowWorkoutCatalog" />
                  <Button fx:id="feedbackBtn" text="&#x2709;  Feedback management" styleClass="side-link" onAction="#onShowFeedback" />
                  <Button fx:id="mentalWellnessBtn" text="&#x1F9E0;  Mental wellness" styleClass="side-link" onAction="#onShowMentalWellness" />
                  <Button fx:id="nutritionBtn" text="&#x1F957;  Nutrition plan" styleClass="side-link" onAction="#onShowNutrition" />
                  <Button fx:id="profileBtn" text="&#x263A;  Profile" styleClass="side-link" onAction="#onShowProfile" />
                  <Button text="&#x23FB;  Sign Out" styleClass="side-link" onAction="#onLogout" />
               </children>
               <padding>
                  <Insets top="22" right="18" bottom="22" left="18" />
               </padding>
            </VBox>
         </left>

         <center>
            <VBox styleClass="admin-main-area" VBox.vgrow="ALWAYS">
               <children>

                  <HBox alignment="CENTER_LEFT" styleClass="admin-navbar">
                     <children>
                        <VBox HBox.hgrow="ALWAYS" spacing="4">
                           <children>
                              <Label fx:id="navbarPageTitle" styleClass="navbar-page-title" text="Coach dashboard" />
                              <Label fx:id="navbarPageSubtitle" styleClass="navbar-page-subtitle" text="Train and support your athletes" />
                           </children>
                        </VBox>

                        <Button fx:id="navbarBellBtn" focusTraversable="false" text="" styleClass="navbar-bell-btn" />

                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="navbar-profile">
                           <children>
                              <VBox alignment="CENTER_LEFT" spacing="2">
                                 <children>
                                    <Label fx:id="navbarUserName" styleClass="navbar-user-name" text="&#x2014;" />
                                    <Label fx:id="navbarUserRole" styleClass="navbar-user-role" text="Coach" />
                                 </children>
                              </VBox>
                              <Label fx:id="navbarAvatar" alignment="CENTER" styleClass="navbar-avatar" text="C" />
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets top="16" right="24" bottom="16" left="24" />
                     </padding>
                  </HBox>

                  <StackPane styleClass="admin-center-stack" VBox.vgrow="ALWAYS">
                     <children>

                        <VBox fx:id="coachDashboardPane" spacing="0" styleClass="admin-content" VBox.vgrow="ALWAYS">
                           <children>
                              <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                          styleClass="coach-dash-scroll" VBox.vgrow="ALWAYS">
                                 <VBox spacing="16">
                                    <padding><Insets top="18" right="18" bottom="24" left="18" /></padding>

                                    <!-- Hero -->
                                    <StackPane styleClass="hero-card">
                                       <children>
                                          <Pane styleClass="hero-overlay" />
                                          <HBox alignment="CENTER_LEFT" spacing="20">
                                             <padding><Insets top="18" right="20" bottom="18" left="20" /></padding>
                                             <VBox spacing="6" HBox.hgrow="ALWAYS">
                                                <Label text="Good morning Coach ! &#x1F44B;" styleClass="hero-title" />
                                                <Label text="Here is an overview of your athletes' nutrition and training today."
                                                       styleClass="hero-subtitle" wrapText="true" />
                                             </VBox>
                                          </HBox>
                                       </children>
                                    </StackPane>

                                    <!-- Stats row -->
                                    <HBox spacing="12">
                                       <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                          <padding><Insets top="14" right="16" bottom="14" left="16" /></padding>
                                          <Label styleClass="stat-title" text="ATHLETES IN ROSTER" />
                                          <Label fx:id="totalAthletesLabel" styleClass="stat-value" text="0" />
                                       </VBox>
                                       <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                          <padding><Insets top="14" right="16" bottom="14" left="16" /></padding>
                                          <Label styleClass="stat-title" text="ACTIVE ATHLETES" />
                                          <Label fx:id="activeAthletesLabel" styleClass="stat-value" text="0" />
                                       </VBox>
                                       <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                          <padding><Insets top="14" right="16" bottom="14" left="16" /></padding>
                                          <Label styleClass="stat-title" text="AVG DURATION" />
                                          <Label fx:id="sessionsLabel" styleClass="stat-value" text="&#x2014;" />
                                       </VBox>
                                       <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                          <padding><Insets top="14" right="16" bottom="14" left="16" /></padding>
                                          <Label styleClass="stat-title" text="TOTAL FEEDBACKS" />
                                          <Label fx:id="totalFeedbacksLabel" styleClass="stat-value" text="&#x2014;" />
                                       </VBox>
                                       <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                          <padding><Insets top="14" right="16" bottom="14" left="16" /></padding>
                                          <Label styleClass="stat-title" text="POSITIVE SENTIMENT" />
                                          <Label fx:id="positiveSentimentLabel" styleClass="stat-value" text="&#x2014;" />
                                       </VBox>
                                    </HBox>

                                    <!-- Top Recipes + Goal Distribution -->
                                    <HBox spacing="14">
                                       <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="dashboard-panel">
                                          <Label text="Top Recipes"
                                                 style="-fx-text-fill:white;-fx-font-size:16px;-fx-font-weight:bold;" />
                                          <Label text="Les plus populaires auprès de vos clients"
                                                 style="-fx-text-fill:#94a3b8;-fx-font-size:11px;" />
                                          <FlowPane fx:id="topRecipesBox" hgap="12" vgap="12"
                                                    style="-fx-background-color:transparent;" />
                                       </VBox>

                                       <VBox spacing="10" prefWidth="340" styleClass="dashboard-panel">
                                          <Label text="GOAL DISTRIBUTION"
                                                 style="-fx-text-fill:white;-fx-font-size:14px;-fx-font-weight:bold;" />
                                          <HBox alignment="CENTER_LEFT" spacing="18">
                                             <StackPane prefWidth="130" prefHeight="130">
                                                <Canvas fx:id="objectiveCanvas" width="130" height="130" />
                                                <VBox alignment="CENTER">
                                                   <Label fx:id="totalClientsLabel" text="0"
                                                          style="-fx-text-fill:white;-fx-font-size:28px;-fx-font-weight:bold;" />
                                                   <Label text="Clients"
                                                          style="-fx-text-fill:#94a3b8;-fx-font-size:12px;" />
                                                </VBox>
                                             </StackPane>
                                             <VBox fx:id="objectiveLegendBox" spacing="10" />
                                          </HBox>
                                       </VBox>
                                    </HBox>

                                    <!-- Analytics title -->
                                    <Label text="Analytics Overview"
                                           style="-fx-text-fill:white;-fx-font-size:26px;-fx-font-weight:800;-fx-padding:8 0 0 0;" />

                                    <!-- Charts row 1: Most Used Exercises + Workouts by Goal -->
                                    <HBox spacing="14">
                                       <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="dashboard-panel">
                                          <Label text="Most Used Exercises"
                                                 style="-fx-text-fill:#94a3b8;-fx-font-size:12px;-fx-font-weight:700;" />
                                          <BarChart fx:id="exerciseBarChart" legendVisible="false"
                                                    prefHeight="220" animated="false"
                                                    style="-fx-background-color:transparent;">
                                             <xAxis><CategoryAxis /></xAxis>
                                             <yAxis><NumberAxis /></yAxis>
                                          </BarChart>
                                       </VBox>

                                       <VBox spacing="8" prefWidth="280" styleClass="dashboard-panel">
                                          <Label text="Workouts by Goal"
                                                 style="-fx-text-fill:#94a3b8;-fx-font-size:12px;-fx-font-weight:700;" />
                                          <PieChart fx:id="goalPieChart" legendVisible="true"
                                                    prefHeight="220" animated="false"
                                                    style="-fx-background-color:transparent;" />
                                       </VBox>
                                    </HBox>

                                    <!-- Charts row 2: Workouts by Level + Feedback Satisfaction -->
                                    <HBox spacing="14">
                                       <VBox spacing="8" prefWidth="280" styleClass="dashboard-panel">
                                          <Label text="Workouts by Level"
                                                 style="-fx-text-fill:#94a3b8;-fx-font-size:12px;-fx-font-weight:700;" />
                                          <PieChart fx:id="levelPieChart" legendVisible="true"
                                                    prefHeight="220" animated="false"
                                                    style="-fx-background-color:transparent;" />
                                       </VBox>

                                       <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="dashboard-panel">
                                          <Label text="Feedback Satisfaction"
                                                 style="-fx-text-fill:#94a3b8;-fx-font-size:12px;-fx-font-weight:700;" />
                                          <VBox fx:id="ratingChartContainer" VBox.vgrow="ALWAYS" />
                                       </VBox>
                                    </HBox>

                                    <!-- Feedback Sentiment -->
                                    <VBox spacing="8" styleClass="dashboard-panel">
                                       <Label text="Feedback Sentiment"
                                              style="-fx-text-fill:#94a3b8;-fx-font-size:12px;-fx-font-weight:700;" />
                                       <VBox fx:id="sentimentChartContainer" />
                                    </VBox>

                                 </VBox>
                              </ScrollPane>
                           </children>
                        </VBox>

                        <VBox fx:id="athletesPane" managed="false" visible="false" spacing="14" styleClass="admin-content">
                           <children>
                              <HBox alignment="CENTER_LEFT" styleClass="users-header">
                                 <children>
                                    <VBox HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="users-title" text="Athletes" />
                                          <Label styleClass="users-subtitle" text="Users in the system (read-only)" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>

                              <TableView fx:id="athletesTable" prefHeight="520" styleClass="users-table">
                                 <columns>
                                    <TableColumn fx:id="nameCol" text="User" prefWidth="300" />
                                    <TableColumn fx:id="roleCol" text="Function" prefWidth="150" />
                                    <TableColumn fx:id="statusCol" text="Status" prefWidth="150" />
                                    <TableColumn fx:id="dateCol" text="Date creation" prefWidth="150" />
                                 </columns>
                              </TableView>
                           </children>
                           <padding>
                              <Insets top="18" right="18" bottom="18" left="18" />
                           </padding>
                        </VBox>

                        <VBox fx:id="chatroomPane" managed="false" visible="false" spacing="12" styleClass="admin-content">
                           <children>
                              <Label styleClass="page-title" text="Chatroom" />
                              <Label styleClass="users-subtitle" text="Team messaging will appear here." wrapText="true" />
                           </children>
                           <padding>
                              <Insets top="18" right="18" bottom="18" left="18" />
                           </padding>
                        </VBox>

                        <VBox fx:id="workoutCatalogPane" managed="false" visible="false" spacing="0" styleClass="admin-content" VBox.vgrow="ALWAYS">
                           <children>
                              <fx:include fx:id="workoutCatalog" source="WorkoutCatalogFragment.fxml" VBox.vgrow="ALWAYS" />
                           </children>
                        </VBox>

                        <VBox fx:id="feedbackPane" managed="false" visible="false" spacing="12" styleClass="admin-content">
                           <children>
                              <Label styleClass="page-title" text="Feedback management" />
                              <Label styleClass="users-subtitle" text="Review feedback from athletes." wrapText="true" />
                           </children>
                           <padding>
                              <Insets top="18" right="18" bottom="18" left="18" />
                           </padding>
                        </VBox>

                        <VBox fx:id="mentalWellnessPane" managed="false" visible="false" spacing="12" styleClass="admin-content">
                           <children>
                              <Label styleClass="page-title" text="Mental wellness" />
                              <Label styleClass="users-subtitle" text="Resources and check-ins for mental health." wrapText="true" />
                           </children>
                           <padding>
                              <Insets top="18" right="18" bottom="18" left="18" />
                           </padding>
                        </VBox>

                        <VBox fx:id="nutritionPane" managed="false" visible="false" spacing="0" styleClass="admin-content" VBox.vgrow="ALWAYS">
                           <children>
                              <fx:include source="RecipeCatalogFragment.fxml" />
                           </children>
                           <padding>
                              <Insets top="18" right="18" bottom="18" left="18" />
                           </padding>
                        </VBox>

                        <VBox fx:id="profilePane" managed="false" visible="false" spacing="0" styleClass="admin-content" VBox.vgrow="ALWAYS">
                           <children>
                              <fx:include fx:id="coachProfile" source="ProfileFragment.fxml" VBox.vgrow="ALWAYS" />
                           </children>
                           <padding>
                              <Insets top="18" right="18" bottom="18" left="18" />
                           </padding>
                        </VBox>

                     </children>
                  </StackPane>

               </children>
            </VBox>
         </center>

      </BorderPane>
   </children>
</StackPane>

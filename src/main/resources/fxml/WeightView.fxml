<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="620.0" prefWidth="980.0" styleClass="onb-root" stylesheets="@../css/onboarding.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.WeightController">
   <children>
      <VBox alignment="CENTER" maxWidth="420.0" spacing="18.0" styleClass="onb-card">
         <children>
            <Label styleClass="onb-title" text="What is your Weight?" />
            <Label styleClass="onb-subtitle" text="Tracking weight helps monitor progress and adjust goals." wrapText="true" />
            <HBox alignment="CENTER" spacing="16.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onMinus" styleClass="round-btn" text="-" />
                  <Label fx:id="weightValueLabel" styleClass="big-value" text="75 kg" />
                  <Button mnemonicParsing="false" onAction="#onPlus" styleClass="round-btn" text="+" />
               </children>
            </HBox>
            <Slider fx:id="weightSlider" blockIncrement="1.0" majorTickUnit="20.0" max="200.0" min="30.0" showTickLabels="false" showTickMarks="false" value="75.0" />
            <HBox alignment="CENTER" spacing="12.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onBack" styleClass="btn-back" text="← Back" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onContinue" styleClass="btn-continue" text="Save and Continue →" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="22.0" left="26.0" right="26.0" top="24.0" />
         </padding>
      </VBox>
   </children>
</StackPane>

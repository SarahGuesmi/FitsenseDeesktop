<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" minHeight="620.0" minWidth="980.0" prefHeight="620.0" prefWidth="980.0"
           styleClass="signin-root" stylesheets="@../css/signin.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.FaceIdQrController">
   <children>

      <!-- Blurred background card -->
      <VBox alignment="CENTER" maxWidth="420.0" spacing="16.0" styleClass="faceid-card">
         <padding><Insets bottom="36.0" left="36.0" right="36.0" top="36.0"/></padding>
         <children>

            <Label styleClass="faceid-title" text="Scan with your phone" />
            <Label styleClass="faceid-subtitle" wrapText="true" alignment="CENTER"
                   text="Open your camera or QR app and scan this code. Then enter your email on your phone." />

            <!-- QR code frame -->
            <StackPane styleClass="faceid-qr-frame" alignment="CENTER">
               <children>
                  <ImageView fx:id="qrImageView" fitHeight="200.0" fitWidth="200.0"
                             preserveRatio="true" smooth="true" />
               </children>
            </StackPane>

            <Label fx:id="statusLabel" styleClass="faceid-status" text="Loading QR code..." />
            <Label fx:id="urlLabel" styleClass="faceid-subtitle" text="" wrapText="true" alignment="CENTER" />

            <Button mnemonicParsing="false" onAction="#onCancel"
                    styleClass="faceid-cancel-btn" text="Cancel" maxWidth="Infinity" />

         </children>
      </VBox>

   </children>
</StackPane>

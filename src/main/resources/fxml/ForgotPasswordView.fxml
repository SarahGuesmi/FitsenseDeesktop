<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" minHeight="620.0" minWidth="980.0" prefHeight="620.0" prefWidth="980.0"
           styleClass="signin-root" stylesheets="@../css/signin.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.ForgotPasswordController">
   <children>

      <!-- Centered card -->
      <VBox alignment="CENTER" maxWidth="440.0" spacing="0" styleClass="signin-card">

         <!-- ── Form box (shown by default) ── -->
         <VBox fx:id="formBox" alignment="TOP_LEFT" spacing="10.0">
            <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>
            <children>
               <Button mnemonicParsing="false" onAction="#onBackToSignIn"
                       styleClass="btn-home-back" text="←  Back to Sign In" />
               <Region prefHeight="20.0" />
               <Label styleClass="welcome-title" text="Forgot Password" />
               <Label styleClass="welcome-subtitle" wrapText="true"
                      text="Enter your email and we'll send you a reset link." />
               <Region prefHeight="20.0" />
               <Label styleClass="field-label" text="EMAIL" />
               <TextField fx:id="emailField" promptText="your@email.com" styleClass="input-field" />
               <Label fx:id="emailError" styleClass="form-error-label"
                      managed="false" visible="false" text="" />
               <Region prefHeight="16.0" />
               <Button fx:id="sendButton" mnemonicParsing="false" onAction="#onSend"
                       styleClass="btn-signin-password" text="SEND RESET LINK"
                       maxWidth="Infinity" />
            </children>
         </VBox>

         <!-- ── Success box (hidden until email sent) ── -->
         <VBox fx:id="successBox" alignment="CENTER" managed="false" visible="false" spacing="18.0">
            <padding><Insets bottom="60.0" left="40.0" right="40.0" top="60.0" /></padding>
            <children>
               <Label styleClass="left-title" text="📬" />
               <Label styleClass="welcome-title" text="Check your inbox" />
               <Label styleClass="welcome-subtitle" alignment="CENTER" wrapText="true"
                      text="A reset link has been sent to your Gmail inbox. Click it to continue — this window will update automatically." />
               <Region prefHeight="10.0" />
               <HBox alignment="CENTER">
                  <Button mnemonicParsing="false" onAction="#onBackToSignIn"
                          styleClass="btn-signup-inline" text="Back to Sign In" />
               </HBox>
            </children>
         </VBox>

      </VBox>
   </children>
</StackPane>
